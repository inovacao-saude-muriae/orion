generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}
datasource db {
  provider = "postgresql"
}

// ── ENUM DE PERFIS DE ACESSO ──────────────────────────────────────────────
enum Role {
  // GESTOR GERAL - Acesso total ao sistema
  GESTOR
  
  // REGULAÇÃO
  REGULACAO_ADMIN   // Acessa tudo da regulação (incluindo financeiro)
  REGULACAO_COMUM   // Acessa regulação, exceto financeiro
  
  // CÂMARA TÉCNICA - FARMÁCIA JUDICIAL
  FARMACIA_ADMIN    // Acessa apenas módulo farmácia
  
  // CÂMARA TÉCNICA - PROCESSOS
  PROCESSO_ADMIN    // Acessa apenas módulo processos
  
  // JUNTA REGULADORA
  JUNTA_ADMIN       // Acessa tudo da junta
  JUNTA_CAEE        // Acessa apenas serviço CAEE
  JUNTA_EDUCACAO    // Acessa apenas serviço Educação
  JUNTA_SAUDE       // Acessa apenas serviço Saúde
  JUNTA_ASSISTENCIA // Acessa apenas serviço Assistência Social
  
  // CCZ (Centro de Controle de Zoonoses)
  CCZ_ADMIN         // Acessa tudo do CCZ
}

// ── AUTENTICAÇÃO E SESSÕES ────────────────────────────────────────────────
model User {
  cpf          String    @id @db.VarChar(11) // CPF como Chave Primária
  nome         String    @db.VarChar(150)
  senhaHash    String    @map("senha_hash") @db.VarChar(255)
  cargo        String?   @db.VarChar(100)
  role         Role      @default(REGULACAO_COMUM)
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime? @map("ultimo_acesso") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.VarChar(11) // Aponta para o CPF de User
  token     String   @unique @db.Text // JWT pode ter 200-500 caracteres
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [cpf], onDelete: Cascade)

  @@map("user_sessions")
}

// ── MODELOS BASE (PESSOAS E ENDEREÇOS) ──────────────────────────────────
model Pessoa {
  cpf              String   @id @db.VarChar(11)
  nomeCompleto     String   @map("nome_completo") @db.VarChar(150)
  sexo             String   @db.VarChar(20)
  dataNascimento   DateTime @map("data_nascimento") @db.Date
  nomeMae          String   @map("nome_mae") @db.VarChar(150)
  telefone         String   @db.VarChar(20)
  cns              String?  @unique @db.VarChar(15) // Não permite CNS duplicado
  ubsReferenciaId  Int?     @map("ubs_referencia_id") // UBS de referência (opcional)

  enderecos        Endereco[]
  pedidos          PedidoExame[]
  tutor            Tutor?
  pacienteFarmacia PacienteFarmaciaJudicial?
  pacienteJunta    PacienteJunta?
  ubsReferencia    Ubs?     @relation(fields: [ubsReferenciaId], references: [id], onDelete: SetNull, map: "fk_pessoa_ubs_referencia")

  @@index([nomeCompleto, dataNascimento], map: "idx_pessoa_nome")
  @@map("pessoa")
}

model Endereco {
  id            Int      @id @default(autoincrement())
  pessoaCpf     String   @map("pessoa_cpf") @db.VarChar(11)
  logradouro    String   @db.VarChar(150)
  numero        String   @db.VarChar(20)
  complemento   String?  @db.VarChar(50)
  bairro        String   @db.VarChar(100)
  cidade        String   @db.VarChar(100)
  uf            String   @db.Char(2)
  cep           String?  @db.VarChar(8)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  enderecoAtual Boolean  @default(true) @map("endereco_atual")

  pessoa Pessoa @relation(fields: [pessoaCpf], references: [cpf], onDelete: Cascade, onUpdate: Cascade, map: "fk_endereco_pessoa")

  @@index([pessoaCpf], map: "pessoa_cpf_idx")
  @@map("pessoa_endereco")
}

// ── MÓDULO: REGULAÇÃO (`regula_`) ────────────────────────────────────────
model TipoExame {
  id            Int            @id @default(autoincrement())
  nome          String         @db.VarChar(50)
  procedimentos Procedimento[]

  @@map("regula_tipo_exame")
}

model Procedimento {
  id          Int           @id @default(autoincrement())
  tipoExameId Int           @map("tipo_exame_id")
  nome        String        @db.VarChar(150)
  valor       Decimal       @db.Decimal(10, 2)
  pedidos     PedidoExame[]

  tipoExame TipoExame @relation(fields: [tipoExameId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_procedimentos_tipo_exames")

  @@index([tipoExameId], map: "exame_id_idx")
  @@map("regula_procedimentos")
}

model Medico {
  id                 Int           @id @default(autoincrement())
  crm                String        @db.VarChar(20)
  ufCrm              String        @map("uf_crm") @db.Char(2)
  nome               String        @db.VarChar(150)
  especialidade      String        @db.VarChar(100)
  ativo              Boolean       @default(true)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tipo               String?
  pedidosResponsavel PedidoExame[] @relation("medico_responsavel")
  pedidosSolicitados PedidoExame[] @relation("medico_solicitante")

  @@unique([crm, ufCrm], map: "idx_medico_crm")
  @@map("regula_medicos")
}

model Ubs {
  id        Int           @id @default(autoincrement())
  cnes      String        @unique @db.VarChar(45)
  nome      String        @db.VarChar(150)
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  pedidos   PedidoExame[]
  pessoas   Pessoa[]

  @@map("regula_ubs")
}

model PedidoExame {
  id                  Int       @id @default(autoincrement())
  pessoaCpf           String    @map("pessoa_cpf") @db.VarChar(11)
  cnsPaciente         String?   @map("cns_paciente") @db.VarChar(15)
  procedimentoId      Int       @map("procedimento_id")
  ubsResponsavelId    Int?      @map("ubs_responsavel_id")
  medicoSolicitanteId Int?      @map("medico_solicitante_id")
  medicoResponsavelId Int?      @map("medico_responsavel_id")
  classificacaoRisco  String?   @map("classificacao_risco") @db.VarChar(50)
  tipoCota            String?   @map("tipo_cota") @db.VarChar(50)
  competenciaCota     String?   @map("competencia_cota") @db.VarChar(7) // "YYYY-MM" — competência que debita o financeiro
  status              String    @default("Aguardando") @db.VarChar(50)
  statusComunicacao   String?   @default("PENDENTE") @map("status_comunicacao") @db.VarChar(50)
  motivoLiberacao     String?   @map("motivo_liberacao")
  observacao          String?
  dataSolicitacao     DateTime? @default(now()) @map("data_solicitacao") @db.Timestamptz(6)
  dataComunicacao     DateTime? @map("data_comunicacao") @db.Timestamptz(6)
  dataLiberacao       DateTime? @map("data_liberacao") @db.Timestamptz(6)

  medicoResponsavel Medico?      @relation("medico_responsavel", fields: [medicoResponsavelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_med_resp")
  medicoSolicitante Medico?      @relation("medico_solicitante", fields: [medicoSolicitanteId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_med_solic")
  pessoa            Pessoa       @relation(fields: [pessoaCpf], references: [cpf], onDelete: Cascade, onUpdate: Cascade, map: "fk_pedidos_pessoa")
  procedimento      Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_procedimento")
  ubs               Ubs?         @relation(fields: [ubsResponsavelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_ubs")

  @@index([pessoaCpf], map: "fk_pedidos_pessoa_idx")
  @@index([status], map: "idx_pedidos_status")
  @@index([dataSolicitacao], map: "idx_pedido_data_solic")
  @@index([procedimentoId], map: "fk_pedidos_procedimento_idx")
  @@index([medicoSolicitanteId], map: "fk_pedidos_med_solic_idx")
  @@index([medicoResponsavelId], map: "fk_pedidos_med_resp_idx")
  @@index([ubsResponsavelId], map: "fk_pedidos_ubs_idx")
  @@map("regula_pedidos_exames")
}

model CotaFinanceira {
  id        Int      @id @default(autoincrement())
  tipoCota  String   @map("tipo_cota") @db.VarChar(50)
  mes       String   @db.VarChar(2)
  ano       String   @db.VarChar(4)
  valorTeto Decimal  @map("valor_teto") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tipoCota, mes, ano], map: "idx_cota_competencia_unica")
  @@map("regula_cotas_financeiras")
}

// Planejamento mensal por cidade (12 meses) — persistido para auditoria.
model PlanejamentoCidade {
  id        Int      @id @default(autoincrement())
  cidade    String   @db.VarChar(120)
  ano       String   @db.VarChar(4)
  mes       String   @db.VarChar(2)
  valor     Decimal  @default(0) @db.Decimal(12, 2)
  updatedBy String?  @map("updated_by") @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([cidade, ano, mes], map: "idx_planejamento_cidade_competencia")
  @@index([ano], map: "idx_planejamento_ano")
  @@map("regula_planejamento_cidade")
}

// ── CADASTRO: SERVIÇOS E ESPECIALIDADES (`cad_`) ─────────────────────────
model Servico {
  id             Int             @id @default(autoincrement())
  nome           String          @db.VarChar(150)
  ativo          Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  especialidades Especialidade[]

  @@map("cad_servicos")
}

model Especialidade {
  id        Int      @id @default(autoincrement())
  servicoId Int      @map("servico_id")
  nome      String   @db.VarChar(150)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade, map: "fk_especialidade_servico")

  @@index([servicoId], map: "idx_especialidade_servico")
  @@map("cad_especialidades")
}

// ── MÓDULO: FARMÁCIA JUDICIAL (`farmacia_`) ──────────────────────────────
model PacienteFarmaciaJudicial {
  numeroPasta    String    @id @map("numero_pasta") @db.VarChar(50)
  pessoaCpf      String    @unique @map("pessoa_cpf") @db.VarChar(11)
  numeroProcesso String    @map("numero_processo") @db.VarChar(100)
  status         String    @default("ATIVO") @db.VarChar(20)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  pessoa       Pessoa                   @relation(fields: [pessoaCpf], references: [cpf], onDelete: Cascade)
  tratamentos  TratamentoPaciente[]
  dispensacoes DispensacaoMedicamento[]

  @@map("farmacia_pacientes")
}

model Medicamento {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(150)
  tipo      String    @db.VarChar(50)
  dosagem   String    @db.VarChar(50)
  ativo     Boolean   @default(true)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  lotes       LoteMedicamento[]
  tratamentos TratamentoPaciente[]

  @@map("farmacia_medicamentos")
}

model LoteMedicamento {
  id            Int       @id @default(autoincrement())
  medicamentoId Int       @map("medicamento_id")
  numeroLote    String    @map("numero_lote") @db.VarChar(50)
  fornecedor    String    @db.VarChar(150)
  qtdInicial    Int       @map("qtd_inicial")
  valorUnitario Decimal   @map("valor_unitario") @db.Decimal(10, 2)
  dataEntrada   DateTime  @default(dbgenerated("CURRENT_DATE")) @map("data_entrada") @db.Date
  dataValidade  DateTime  @map("data_validade") @db.Date
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  medicamento  Medicamento              @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  dispensacoes DispensacaoMedicamento[]

  @@map("farmacia_lotes_medicamentos")
}

model TratamentoPaciente {
  id                 Int       @id @default(autoincrement())
  pacientePasta      String    @map("paciente_pasta") @db.VarChar(50)
  medicamentoId      Int       @map("medicamento_id")
  qtdPrescritaMensal Int       @map("qtd_prescrita_mensal")
  ativo              Boolean   @default(true)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  paciente    PacienteFarmaciaJudicial @relation(fields: [pacientePasta], references: [numeroPasta], onDelete: Cascade)
  medicamento Medicamento              @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)

  @@map("farmacia_tratamentos_pacientes")
}

model DispensacaoMedicamento {
  id                Int       @id @default(autoincrement())
  pacientePasta     String    @map("paciente_pasta") @db.VarChar(50)
  loteMedicamentoId Int       @map("lote_medicamento_id")
  qtdEntregue       Int       @map("qtd_entregue")
  dataDispensacao   DateTime? @default(now()) @map("data_dispensacao") @db.Timestamptz(6)
  observacao        String?

  paciente PacienteFarmaciaJudicial @relation(fields: [pacientePasta], references: [numeroPasta], onDelete: Cascade)
  lote     LoteMedicamento          @relation(fields: [loteMedicamentoId], references: [id], onDelete: Cascade)

  @@map("farmacia_dispensacoes_medicamentos")
}

// ── MÓDULO: JUNTA MÉDICA (`junta_`) ─────────────────────────────────────
model PacienteJunta {
  id              Int       @id @default(autoincrement())
  pessoaCpf       String    @unique @map("pessoa_cpf") @db.VarChar(11)
  tipoDeficiencia String    @map("tipo_deficiencia") @db.VarChar(255)
  observacoes     String?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  pessoa       Pessoa                 @relation(fields: [pessoaCpf], references: [cpf], onDelete: Cascade)
  servicos     PacienteJuntaServico[]
  atendimentos JuntaAtendimento[]

  @@map("junta_pacientes")
}

model JuntaServico {
  id        Int       @id @default(autoincrement())
  nome      String    @unique @db.VarChar(100)
  descricao String?
  ativo     Boolean?  @default(true)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  pacientes    PacienteJuntaServico[]
  atendimentos JuntaAtendimento[]

  @@map("junta_servicos")
}

model PacienteJuntaServico {
  pacienteJuntaId Int       @map("paciente_junta_id")
  servicoId       Int       @map("servico_id")
  dataVinculo     DateTime? @default(now()) @map("data_vinculo") @db.Timestamptz(6)
  ativo           Boolean?  @default(true)

  pacientePacienteJunta PacienteJunta @relation(fields: [pacienteJuntaId], references: [id], onDelete: Cascade)
  servico               JuntaServico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@id([pacienteJuntaId, servicoId])
  @@map("junta_paciente_servicos")
}

model JuntaAtendimento {
  id                      Int       @id @default(autoincrement())
  pacienteJuntaId         Int       @map("paciente_junta_id")
  servicoId               Int       @map("servico_id")
  especialidade           String    @db.VarChar(100)
  dataAtendimento         DateTime  @map("data_atendimento") @db.Date
  status                  String    @db.VarChar(20)
  observacao              String?
  profissionalResponsavel String?   @map("profissional_responsavel") @db.VarChar(150)
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  pacienteJunta PacienteJunta @relation(fields: [pacienteJuntaId], references: [id], onDelete: Cascade)
  servico       JuntaServico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@map("junta_atendimentos")
}

// ── MÓDULO: CCZ / ZOONOSES (`ccz_`) ─────────────────────────────────────
model Tutor {
  pessoaCpf          String    @id(map: "tutor_zoonoses_pkey") @map("pessoa_cpf") @db.VarChar(11)
  rg                 String?   @db.VarChar(20)
  sexo               String?   @db.VarChar(20)
  profissao          String?   @db.VarChar(100)
  telefoneSecundario String?   @map("telefone_secundario") @db.VarChar(20)
  pontoReferencia    String?   @map("ponto_referencia") @db.VarChar(150)
  observacoes        String?
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  pessoa  Pessoa   @relation(fields: [pessoaCpf], references: [cpf], onDelete: Cascade)
  animais Animal[]

  @@map("ccz_tutores")
}

model Animal {
  id                     String    @id @db.VarChar(50)
  pessoaCpf              String?   @map("pessoa_cpf") @db.VarChar(11)
  fotoUrl                String?   @map("foto_url")
  nome                   String?   @db.VarChar(100)
  especie                String    @db.VarChar(50)
  sexo                   String    @db.Char(1)
  porte                  String    @db.VarChar(20)
  idade                  String?   @db.VarChar(50)
  castrado               String?   @default("Não") @db.VarChar(10)
  doencaCronica          String?   @default("Não") @map("doenca_cronica") @db.VarChar(10)
  sintomasVomitoDiarreia String?   @default("Não") @map("sintomas_vomito_diarreia") @db.VarChar(10)
  apetiteNormal          String?   @default("Sim") @map("apetite_normal") @db.VarChar(10)
  emTratamento           String?   @default("Não") @map("em_tratamento") @db.VarChar(10)
  qualTratamento         String?   @map("qual_tratamento") @db.VarChar(150)
  observacoes            String?
  possuiResponsavel      String?   @default("Sim") @map("possui_responsavel") @db.VarChar(10)
  enderecoRecolhimento   String?   @map("endereco_recolhimento")
  dataCadastro           DateTime? @default(now()) @map("data_cadastro") @db.Timestamptz(6)

  tutor         Tutor?                 @relation(fields: [pessoaCpf], references: [pessoaCpf], onDelete: SetNull)
  procedimentos CadastroProcedimento[]
  zoonoses      CadastroZoonoses[]
  denuncias     DenunciaCaoAgressivo[]
  esporotricose Esporotricose[]

  @@map("ccz_animais")
}

model CadastroProcedimento {
  id                 String    @id(map: "zoonoses_procedimento_pkey") @db.VarChar(50)
  animalId           String    @map("animal_id") @db.VarChar(50)
  tipo               String    @db.VarChar(50)
  dataProcedimento   DateTime  @map("data_procedimento") @db.Date
  veterinario        String?   @db.VarChar(150)
  status             String    @default("Realizado") @db.VarChar(30)
  descricao          String?
  medicacaoPrescrita String?   @map("medicacao_prescrita")
  dataRetorno        DateTime? @map("data_retorno") @db.Date
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId], map: "idx_procedimento_animal")
  @@map("ccz_procedimentos")
}

model CadastroZoonoses {
  id                       String    @id(map: "zoonoses_notificacao_pkey") @db.VarChar(50)
  animalId                 String    @map("animal_id") @db.VarChar(50)
  doenca                   String    @db.VarChar(100)
  dataIdentificacao        DateTime  @map("data_identificacao") @db.Date
  grauRisco                String    @map("grau_risco") @db.VarChar(30)
  riscoVida                String?   @default("Não") @map("risco_vida") @db.VarChar(10)
  formasContaminacao       String?   @map("formas_contaminacao")
  periodoMonitoramento     String    @map("periodo_monitoramento") @db.VarChar(50)
  responsavelMonitoramento String?   @map("responsavel_monitoramento") @db.VarChar(150)
  observacao               String?
  createdAt                DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("ccz_zoonoses_notificacoes")
}

model DenunciaCaoAgressivo {
  id           String    @id(map: "zoonoses_denuncia_pkey") @db.VarChar(50)
  dataDenuncia DateTime? @default(now()) @db.Timestamptz(6)
  localizacao  String
  descricaoCao String    @map("descricao_cao")
  relato       String
  animalId     String?   @map("animal_id") @db.VarChar(50)
  causouRisco  String?   @default("Não") @map("causou_risco") @db.VarChar(10)

  animal Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@map("ccz_denuncias")
}

model Esporotricose {
  id                      String    @id(map: "zoonoses_esporotricose_pkey") @db.VarChar(50)
  animalId                String?   @map("animal_id") @db.VarChar(50)
  numeroProtocolo         String?   @map("numero_protocolo") @db.VarChar(50)
  dataVisita              DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  fiscalResponsavel       String?   @map("fiscal_responsavel") @db.VarChar(150)
  apresentaLesoes         String?   @default("Sim") @db.VarChar(10)
  descricaoLesoes         String?   @map("descricao_lesoes")
  emTratamentoContinuo    String?   @default("Sim") @db.VarChar(10)
  profissionalServicoRef String?   @map("profissional_servico_ref") @db.VarChar(150)
  medicamentosPrescritos String?   @map("medicamentos_prescritos")
  interrupcaoTratamento   String?   @default("Não") @db.VarChar(10)
  retornoVeterinario      String?   @default("Sim") @db.VarChar(10)
  isolamentoDomiciliar    String?   @default("Sim") @db.VarChar(10)
  observacoesIsolamento   String?   @map("observacoes_isolamento")
  acessoRua               String?   @default("Não") @db.VarChar(10)
  usoEpi                  String?   @default("Sim") @db.VarChar(10)
  quaisEpis               String?   @map("quais_epis") @db.VarChar(150)
  higienizacaoAmbiente    String?   @map("higienizacao_ambiente")
  outrosAnimaisResidencia String?   @default("Não") @db.VarChar(10)
  outrosAnimaisDescricao  String?   @map("outros_animais_descricao")
